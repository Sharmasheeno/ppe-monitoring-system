# ---------- MongoDB ----------
MONGO_URI=mongodb://localhost:27017/ppe_monitoring

# ---------- JWT ----------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---------- Server ----------
PORT=5001
NODE_ENV=development
# Set to the public IP or domain when running behind a reverse proxy
PUBLIC_HOST=http://localhost:5001

# ---------- Email (password reset via nodemailer) ----------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your@gmail.com
MAIL_PASS=app-password-here
MAIL_FROM="Sentinel PPE <no-reply@sentinel.local>"

# ---------- MQTT broker (embedded Aedes) ----------
MQTT_PORT=1883
